vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
  }
}

style.fill: "#1E1E2E"

header: {
  label: ""
  near: top-center
  grid-rows: 2
  grid-gap: 8
  style.fill: "#1E1E2E"
  style.stroke: transparent

  title_text: "TrustSender.io Engineering Overview" {
    shape: text
    style: {
      fill: transparent
      stroke: transparent
      font-color: "#edf3ff"
      font-size: 32
      bold: true
    }
  }
  subtitle_text: "P1 distributed validation is operational; P2 SMTP evolution remains ONGOING." {
    shape: text
    style: {
      fill: transparent
      stroke: transparent
      font-color: "#cbd5e1"
      font-size: 18
      bold: false
    }
  }
}

classes: {
  operational: {
    style: {
      stroke: "#8bb8ff"
      stroke-width: 2
      fill: "#172033"
      font-color: "#edf3ff"
    }
  }
  ongoing: {
    style: {
      stroke: "#f59e0b"
      stroke-width: 2
      stroke-dash: 6
      fill: "#2a2115"
      font-color: "#ffe7b0"
    }
  }
  external: {
    style: {
      stroke: "#94a3b8"
      stroke-width: 2
      fill: "#151b26"
      font-color: "#e2e8f0"
    }
  }
  data: {
    shape: cylinder
    style: {
      stroke: "#60a5fa"
      stroke-width: 3
      fill: "#10243f"
      font-color: "#dbeafe"
    }
  }
  area: {
    style: {
      stroke: "#334155"
      stroke-width: 2
      border-radius: 12
      fill: "#0f172a"
      font-color: "#cbd5e1"
      font-size: 18
      bold: true
    }
  }
}

composition: {
  label: ""
  grid-rows: 3
  grid-gap: 46
  style.fill: "#1E1E2E"
  style.stroke: transparent

  upper: {
    label: ""
    grid-columns: 2
    grid-gap: 42
    style.fill: "#1E1E2E"
    style.stroke: transparent

    users: {
      label: "1. Users"
      class: area
      grid-columns: 2
      grid-gap: 28
      customer: "Customer" {
        class: operational
        width: 190
        height: 70
      }
      operator: "Platform Operator" {
        class: operational
        width: 190
        height: 70
      }
    }

    experience: {
      label: "2. Experience and Routing\nPublic access and experience"
      class: area
      grid-rows: 2
      grid-gap: 30
      edge: "Edge and Routing" {
        class: operational
        width: 260
        height: 120
      }
      web: "Web Application" {
        class: operational
        width: 230
        height: 90
      }
      blog: "WordPress Blog\nEditorial route; isolated from application authority" {
        class: operational
        width: 270
        height: 105
      }
    }
  }

  core: {
    label: ""
    grid-columns: 2
    grid-gap: 52
    style.fill: "#1E1E2E"
    style.stroke: transparent

    authority: {
      label: "3. Application Authority and Data\nApplication authority"
      class: area
      grid-rows: 2
      grid-gap: 40
      api: "Application API" {
        class: operational
        width: 320
        height: 180
      }
      db: "PostgreSQL Database\nAuthoritative data store" {
        class: data
        width: 300
        height: 125
      }
    }

    validation: {
      label: "4. Validation Control and Execution"
      class: area
      grid-rows: 2
      grid-gap: 46
      control: {
        label: "Job orchestration"
        class: area
        job: "Job Control Plane" {
          class: operational
          width: 320
          height: 170
        }
      }
      execution: {
        label: ""
        grid-columns: 2
        grid-gap: 48
        style.fill: "#1E1E2E"
        style.stroke: transparent
        p1: {
          label: "Operational P1 execution"
          class: area
          workers: "Distributed P1 Worker Plane\nOperational" {
            class: operational
            width: 340
            height: 160
          }
        }
        p2: {
          label: "Ongoing P2 evolution"
          class: area
          smtp: "P2 SMTP Execution Plane\nONGOING" {
            class: ongoing
            width: 340
            height: 160
          }
        }
      }
    }
  }

  external: {
    label: "5. External Services and Infrastructure\nExternal dependencies"
    class: area
    grid-columns: 2
    grid-gap: 46
    application_services: {
      label: ""
      grid-columns: 2
      grid-rows: 2
      grid-gap: 30
      style.fill: "#1E1E2E"
      style.stroke: transparent
      google: "Google Identity" {
        class: external
        width: 210
        height: 75
      }
      microsoft: "Microsoft Identity" {
        class: external
        width: 210
        height: 75
      }
      stripe: "Stripe" {
        class: external
        width: 210
        height: 75
      }
      brevo: "Brevo" {
        class: external
        width: 210
        height: 75
      }
    }
    delivery_infrastructure: {
      label: ""
      grid-rows: 2
      grid-gap: 34
      style.fill: "#1E1E2E"
      style.stroke: transparent
      gha: "GitHub Actions\nExternal CI/CD and deployment automation" {
        class: external
        width: 270
        height: 95
      }
      mail: "Internet Mail Infrastructure\nExternal" {
        class: external
        width: 280
        height: 110
      }
    }
  }
}

