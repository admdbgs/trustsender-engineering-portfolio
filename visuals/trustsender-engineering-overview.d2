vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 200
  }
}

title: "TrustSender.io Engineering Overview"
subtitle: "P1 distributed validation is operational; P2 SMTP evolution remains ONGOING."

direction: right

classes: {
  operational: {
    style: {
      stroke: "#8bb8ff"
      stroke-width: 2
      fill: "#172033"
      font-color: "#edf3ff"
    }
  }
  ongoing: {
    style: {
      stroke: "#f59e0b"
      stroke-width: 2
      stroke-dash: 6
      fill: "#2a2115"
      font-color: "#ffe7b0"
    }
  }
  external: {
    style: {
      stroke: "#94a3b8"
      stroke-width: 2
      fill: "#151b26"
      font-color: "#e2e8f0"
    }
  }
  data: {
    shape: cylinder
    style: {
      stroke: "#60a5fa"
      stroke-width: 3
      fill: "#10243f"
      font-color: "#dbeafe"
    }
  }
  area: {
    style: {
      stroke: "#334155"
      stroke-width: 2
      fill: "#0f172a"
      font-color: "#cbd5e1"
    }
  }
}

users: {
  label: "1. Users"
  class: area
  customer: "Customer" { class: operational }
  operator: "Platform Operator" { class: operational }
}

experience: {
  label: "2. Experience and Routing\nPublic access and experience"
  class: area
  edge: "Edge and Routing" { class: operational }
  web: "Web Application" { class: operational }
  blog: "WordPress Blog\nEditorial route; isolated from application authority" { class: operational }
}

authority: {
  label: "3. Application Authority and Data\nApplication authority"
  class: area
  api: "Application API" { class: operational }
  db: "PostgreSQL Database\nAuthoritative data store" { class: data }
}

validation: {
  label: "4. Validation Control and Execution"
  class: area
  control: {
    label: "Job orchestration"
    class: area
    job: "Job Control Plane" { class: operational }
  }
  p1: {
    label: "Operational P1 execution"
    class: area
    workers: "Distributed P1 Worker Plane\nOperational" { class: operational }
  }
  p2: {
    label: "Ongoing P2 evolution"
    class: area
    smtp: "P2 SMTP Execution Plane\nONGOING" { class: ongoing }
  }
}

external: {
  label: "5. External Services and Infrastructure\nExternal dependencies"
  class: area
  google: "Google Identity" { class: external }
  microsoft: "Microsoft Identity" { class: external }
  stripe: "Stripe" { class: external }
  brevo: "Brevo" { class: external }
  gha: "GitHub Actions\nExternal CI/CD and deployment automation" { class: external }
  mail: "Internet Mail Infrastructure\nExternal" { class: external }
}

users.customer -> experience.edge: "Accesses" { style.stroke: "#8bb8ff" }
users.operator -> experience.edge: "Accesses approved interfaces" { style.stroke: "#8bb8ff" }
experience.edge -> experience.web: "Routes application traffic" { style.stroke: "#8bb8ff" }
experience.edge -> authority.api: "Routes API traffic" { style.stroke: "#8bb8ff" }
experience.edge -> experience.blog: "Routes blog traffic" { style.stroke: "#8bb8ff" }
experience.web -> authority.api: "Uses" { style.stroke: "#8bb8ff" }
authority.api -> authority.db: "Reads and writes authoritative application data" { style.stroke: "#8bb8ff" }
authority.api -> validation.control.job: "Submits and manages jobs" { style.stroke: "#8bb8ff" }
validation.control.job -> authority.db: "Reads and writes lifecycle state" { style.stroke: "#8bb8ff" }
validation.control.job -> validation.p1.workers: "Dispatches authorized work" { style.stroke: "#8bb8ff" }
validation.p1.workers -> external.mail: "Queries for current P1 validation evidence" { style.stroke: "#8bb8ff" }
validation.p1.workers -> validation.control.job: "Returns progress, evidence, and artifacts" { style.stroke: "#8bb8ff" }
authority.api -> external.google: "Uses for federated authentication" { style.stroke: "#8bb8ff" }
authority.api -> external.microsoft: "Uses for federated authentication" { style.stroke: "#8bb8ff" }
authority.api -> external.stripe: "Coordinates checkout and signed payment events" { style.stroke: "#8bb8ff" }
authority.api -> external.brevo: "Requests transactional and operational email" { style.stroke: "#8bb8ff" }
external.gha -> experience.edge: "Builds and deploys reviewed releases" { style.stroke: "#8bb8ff" }
validation.control.job -> validation.p2.smtp: "Will dispatch eligible recipients" {
  style.stroke: "#f59e0b"
  style.stroke-dash: 6
}
validation.p2.smtp -> external.mail: "Will perform conservative recipient handshakes" {
  style.stroke: "#f59e0b"
  style.stroke-dash: 6
}
validation.p2.smtp -> validation.control.job: "Will return typed SMTP evidence" {
  style.stroke: "#f59e0b"
  style.stroke-dash: 6
}
