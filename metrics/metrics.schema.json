{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustsender.io/schemas/portfolio-metrics.schema.json",
  "title": "Sanitized Aggregate Engineering Metrics",
  "description": "Schema for approved aggregate metrics intended for public portfolio publication.",
  "type": "object",
  "properties": {
    "api_endpoints": {
      "type": "integer",
      "minimum": 0
    },
    "database_tables": {
      "type": "integer",
      "minimum": 0
    },
    "migrations": {
      "type": "integer",
      "minimum": 0
    },
    "workflows": {
      "type": "integer",
      "minimum": 0
    },
    "source_files": {
      "type": "integer",
      "minimum": 0
    },
    "code_lines": {
      "type": "integer",
      "minimum": 0
    },
    "test_files": {
      "type": "integer",
      "minimum": 0
    },
    "systemd_units": {
      "type": "integer",
      "minimum": 0
    },
    "external_integrations": {
      "type": "integer",
      "minimum": 0
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
